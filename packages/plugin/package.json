{
  "name": "@spinejit/spine-plugin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "pi": {
    "extensions": [
      "./dist/pi/extension.js"
    ]
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./pi": {
      "types": "./dist/pi/index.d.ts",
      "import": "./dist/pi/index.js"
    },
    "./pi/extension": {
      "types": "./dist/pi/extension.d.ts",
      "import": "./dist/pi/extension.js"
    },
    "./deepseek-harness": {
      "types": "./dist/deepseek-harness/index.d.ts",
      "import": "./dist/deepseek-harness/index.js"
    },
    "./deepseek-harness/extension": {
      "types": "./dist/deepseek-harness/extension.d.ts",
      "import": "./dist/deepseek-harness/extension.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test test/*.test.mjs"
  },
  "dependencies": {
    "@spinejit/spine-sdk": "0.1.0",
    "typebox": "1.3.7"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "0.84.2"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.84.2"
  }
}
